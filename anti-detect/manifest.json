{
  "manifest_version": 3,
  "name": "Snake",
  "version": "1.1",
  "content_scripts": [{
    "matches": [
      "*://*.iub.edu.pk/*",
      "*://127.0.0.1/*",
      "*://localhost/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true,
    "match_about_blank": true
  }]
}